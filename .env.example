# Supabase → Project Settings → API（或 Connect）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# 兩個帳號的 email（只在伺服器端使用，畫面上不會出現）
# 要和 Supabase → Authentication → Users 裡建立的帳號一模一樣
NEKO_EMAIL=neko@example.com
NEZUMI_EMAIL=nezumi@example.com

# ── 鼠的班表自動同步（只放在 Vercel，不要寫進 git）──
# 班表網站 hr.tup.j91.me 的帳號密碼
HR_USERNAME=
HR_PASSWORD=
# Supabase → Project Settings → API Keys 的 Secret key（sb_secret_ 開頭，會略過 RLS，只在伺服器用）
SUPABASE_SECRET_KEY=
# 隨便一串長長的亂碼；Vercel Cron 會用它呼叫 /api/shifts/sync
CRON_SECRET=
